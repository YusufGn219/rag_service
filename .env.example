# Absolute path of the folder whose subfolders (or itself) contain your .md notes. REQUIRED.
RAG_VAULT_ROOT=/path/to/your/notes

# Where the index is stored. Optional; must NOT be inside RAG_VAULT_ROOT.
# Default: <project>/data/index
# RAG_INDEX_DIR=/path/to/index

# Comma-separated directory names to skip while scanning. Optional.
# Default: .git,.obsidian,.trash
# RAG_EXCLUDE_DIRS=.git,.obsidian,.trash
